<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>基本设置</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>default</key><true/>
            <key>defaults</key><string>com.yourname.gptfloatball</string>
            <key>key</key><string>enabled</string>
            <key>label</key><string>启用悬浮球</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>API 配置</string>
            <key>footerText</key><string>支持OpenAI及兼容接口（中转站）</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>defaults</key><string>com.yourname.gptfloatball</string>
            <key>key</key><string>apiKey</string>
            <key>label</key><string>API Key</string>
            <key>placeholder</key><string>sk-xxxxxxxx</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>defaults</key><string>com.yourname.gptfloatball</string>
            <key>key</key><string>apiBaseURL</string>
            <key>label</key><string>API地址</string>
            <key>placeholder</key><string>https://api.openai.com/v1/chat/completions</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>defaults</key><string>com.yourname.gptfloatball</string>
            <key>key</key><string>modelName</string>
            <key>label</key><string>模型</string>
            <key>placeholder</key><string>gpt-4o-mini</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>外观设置</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>defaults</key><string>com.yourname.gptfloatball</string>
            <key>key</key><string>iconPath</string>
            <key>label</key><string>图标路径</string>
            <key>placeholder</key><string>/var/mobile/ball.png（留空用默认）</string>
        </dict>

        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>数据管理</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>清除对话记录</string>
            <key>action</key><string>clearHistory</string>
        </dict>

    </array>
    <key>title</key><string>GPT悬浮球</string>
</dict>
</plist>
